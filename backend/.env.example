# Copy to .env for local development. In production these are set as
# real environment variables (see render.yaml / the Render dashboard),
# not as a checked-in file.

DATABASE_URL=postgresql+psycopg://budgeting:budgeting@localhost:5433/budgeting
JWT_SECRET=dev-secret-change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# Used only by scripts/seed_owner.py.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me
